# Copy to .env and fill in. .env is gitignored; this file is the template.
#
# The defaults in docker-compose.yml are fine for a laptop and wrong for the
# home server: the database password below is what actually protects the
# catalog once the stack is reachable over the tailnet.

POSTGRES_USER=majordomo
POSTGRES_PASSWORD=change-me

# Google OAuth. Without these the app still starts and falls back to form
# login — it does not fail at boot, so a missing value shows up as a broken
# sign-in button rather than an error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key. Envoy scoring and the Librarian's shelf-photo extraction
# fail at the point of use without it, not at startup.
ANTHROPIC_API_KEY=

# Segue's MCP endpoint. Segue binds to loopback and has no authentication
# (its ADR-28), so it must run on the same host as majordomo — see ADR-0024.
# From inside the app container, the host is host.docker.internal, not
# 127.0.0.1, which would be the container itself.
LIBRARIAN_SEGUE_ENDPOINT=http://host.docker.internal:8080/mcp
